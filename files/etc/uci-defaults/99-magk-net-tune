#!/bin/sh
# =============================================================================
# MAGK Net — RPi4-MM6108 (SPI) first-boot tuning
# =============================================================================
# Bakes in the fixes validated on the bench (2026-06-20) so a freshly flashed
# node comes up correct without per-node SSH patching:
#   1. Morse HaLow radio: real board BCF (OTP is unprogrammed) + a US 4 MHz mesh
#      channel (NOT the discouraged 8 MHz).
#   2. Disable the phantom mac80211 device that the wireless detection binds to
#      the same SPI phy as the Morse chip (it breaks the s1g mesh).
#   3. EUD access points on the 2x MT7610U USB dongles: 5 GHz MAGK-TAC (low
#      power) + 2.4 GHz MAGK-NET, both bridged into the mesh (ahwlan).
#   4. batman-adv hard-interface MTU 1532 (avoid L2 fragmentation).
#
# Board-gated + idempotent. Re-runnable. Edit SSIDs/keys/channel to taste.
# =============================================================================

# --- Board gate: only the RPi4 + MM6108 (SPI) node ---
MODEL="$(cat /tmp/sysinfo/model 2>/dev/null)"
case "$MODEL" in
	*MM6108*) : ;;
	*) exit 0 ;;
esac

# Ensure a wireless config exists; give USB Wi-Fi a moment to enumerate so the
# dongle phys are present before we read/assign them.
i=0
while [ "$i" -lt 20 ]; do
	[ -e /sys/class/ieee80211/phy0 ] && break
	i=$((i + 1)); sleep 1
done
[ -s /etc/config/wireless ] || wifi config 2>/dev/null

dev_list() { uci -q show wireless | sed -n 's/^wireless\.\([^.]*\)=wifi-device/\1/p'; }
iface_list() { uci -q show wireless | sed -n 's/^wireless\.\([^.]*\)=wifi-iface/\1/p'; }

# --- 1 + 2: Morse HaLow radio + phantom mac80211 on the same SPI phy ----------
for d in $(dev_list); do
	t="$(uci -q get wireless.$d.type)"
	p="$(uci -q get wireless.$d.path)"
	case "$t:$p" in
		morse:*)
			uci set wireless.$d.bcf='bcf_fgh100mhaamd.bin'
			uci set wireless.$d.country='US'
			uci set wireless.$d.channel='24'      # US 4 MHz (914 MHz), op_class 70
			uci set wireless.$d.htmode='4MHz'
			uci set wireless.$d.disabled='0'
			;;
		mac80211:*spi0.0*)
			# mac80211 wrongly bound to the Morse SPI phy -> disable it + its ifaces
			uci set wireless.$d.disabled='1'
			for s in $(iface_list); do
				[ "$(uci -q get wireless.$s.device)" = "$d" ] && uci set wireless.$s.disabled='1'
			done
			;;
	esac
done

# --- 3: EUD APs on the 2x MT7610U USB dongles (mac80211 on a USB path) --------
n=0
for d in $(dev_list); do
	[ "$(uci -q get wireless.$d.type)" = "mac80211" ] || continue
	echo "$(uci -q get wireless.$d.path)" | grep -qi "usb" || continue
	n=$((n + 1))
	case "$n" in
		1)  # 5 GHz personal TAC AP (intentionally low power)
			uci set wireless.$d.disabled='0'; uci set wireless.$d.band='5g'
			uci set wireless.$d.channel='36';  uci set wireless.$d.htmode='VHT80'
			uci set wireless.$d.country='US';  uci set wireless.$d.txpower='10'
			uci -q delete wireless.magk_tac
			uci set wireless.magk_tac='wifi-iface'
			uci set wireless.magk_tac.device="$d"
			uci set wireless.magk_tac.mode='ap'
			uci set wireless.magk_tac.network='ahwlan'
			uci set wireless.magk_tac.ssid='MAGK-TAC'
			uci set wireless.magk_tac.encryption='psk2'
			uci set wireless.magk_tac.key='magktac1' ;;
		2)  # 2.4 GHz shared access AP
			uci set wireless.$d.disabled='0'; uci set wireless.$d.band='2g'
			uci set wireless.$d.channel='6';   uci set wireless.$d.htmode='HT20'
			uci set wireless.$d.country='US';  uci set wireless.$d.txpower='20'
			uci -q delete wireless.magk_net
			uci set wireless.magk_net='wifi-iface'
			uci set wireless.magk_net.device="$d"
			uci set wireless.magk_net.mode='ap'
			uci set wireless.magk_net.network='ahwlan'
			uci set wireless.magk_net.ssid='MAGK-NET'
			uci set wireless.magk_net.encryption='psk2'
			uci set wireless.magk_net.key='magknet1' ;;
	esac
done

uci commit wireless

# --- 4: batman-adv hard-interface MTU 1532 ------------------------------------
for net in $(uci -q show network | sed -n 's/^network\.\([^.]*\)=interface/\1/p'); do
	[ "$(uci -q get network.$net.proto)" = "batadv_hardif" ] && uci set network.$net.mtu='1532'
done
uci commit network

# Apply now if wifi is already running (no-op on the very first preinit pass).
wifi reload 2>/dev/null

exit 0
