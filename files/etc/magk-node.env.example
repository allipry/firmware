# =============================================================================
# node.env — per-node provisioning parameters for magk-provision-node.sh
# Copy to node.env, edit, and DO NOT commit (it holds Wi-Fi/mesh keys).
# Every node on the same mesh MUST share MESH_ID + MESH_KEY (+ the AP keys if
# you want one roaming SSID) — only NODE_NAME / NODE_ROLE / NODE_MGMT_IP differ.
# =============================================================================

# --- How the provisioning wrapper reaches the node over SSH -------------------
# A freshly flashed node serves its setup IP on eth0; the wrapper SSHes here by
# default. Override per run with:  magk-provision-node --ip <ip> --type ...
INIT_IP="10.41.254.1"

# --- Node identity & role ----------------------------------------------------
# NOTE: with the magk-provision-node wrapper, NODE_NAME / NODE_ROLE are set from
# --type/--num and the values below are ignored (they apply only if you run
# magk-provision-node.sh directly on a node).
NODE_NAME="QA1"              # hostname
NODE_ROLE="meshpoint"        # gateway | meshpoint
                             #   gateway   = gw_mode=server + DHCP server + NAT uplink (eth0)
                             #   meshpoint = gw_mode=client, no DHCP server (gateway serves the shared L2)
# Mesh-point management IPs are assigned automatically by openmanetd (a unique
# MAC-derived 10.41.x.x per node) — you do NOT set them. Discover a node from the
# gateway with:  batctl meshif bat0 dat_cache   (or reach it by hostname).
# NODE_MGMT_IP applies to the GATEWAY only (defaults to 10.41.0.1 if unset).
# NODE_MGMT_IP="10.41.0.1"
MGMT_NETMASK="255.255.0.0"

# --- HaLow 802.11s mesh (morse MM6108 or MM8108; SPI or USB) ------------------
# Chip is auto-detected (type=morse) and the BCF is auto-set by the board's
# morse-board-config-hotplug-model package, so 6108 vs 8108 needs no change here
# beyond channel/bandwidth.
MESH_ID="MAGK-NET"           # 802.11s mesh id — identical on all nodes
MESH_KEY="MAGKTech2024!"     # SAE/WPA3 mesh key — identical on all nodes
MESH_CHANNEL="24"            # US S1G ch24 = 4 MHz @ 914 MHz (good for 6108 & 8108)
# MESH_HTMODE="8MHz"         # optional: e.g. 8MHz on MM8108 for higher throughput

# --- EUD AP = 5 GHz (MANET operator's phone/tablet) ---------------------------
# Band ROLE, not a fixed radio: the script puts 5 GHz on whichever radio can do
# it — the onboard Wi-Fi on a Pi4 (CYW43455), or the USB dongle on a Pi Zero
# (2.4 GHz-only onboard). No change needed per hardware variant.
EUD_5G_SSID="MAGK-EUD"
EUD_5G_KEY="magkeud1"
EUD_5G_CHANNEL="36"          # non-DFS UNII-1

# --- NET AP = 2.4 GHz (other players without a MANET radio) -------------------
# Goes on the remaining radio (onboard on Pi4, or onboard 2.4-only on Pi Zero).
NET_24_SSID="MAGK-NET"
NET_24_KEY="magknet1"
NET_24_CHANNEL="6"

# --- Gateway-only uplink (ignored for meshpoint) ------------------------------
WAN_IFACE="eth0"             # interface that reaches the upstream/Internet

# --- Fast roaming (802.11r/k/v) on the EUD + NET APs --------------------------
# Lets non-MANET clients hand off cleanly between nodes (one ESS over the mesh).
# 1 = on (recommended), 0 = off. PSK clients that don't support FT still connect.
FAST_ROAM="1"
