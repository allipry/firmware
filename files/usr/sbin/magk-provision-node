#!/bin/sh
# =============================================================================
# magk-provision-node.sh — non-interactive MAGK node provisioning from a .env.
#
# The ekhwizards setup wizard is browser-only (ucode/JS, no CLI), so this script
# reproduces the UCI config it writes — parameterised from a .env file — for the
# MAGK single-dongle topology:
#   - HaLow 802.11s mesh over morse  (radio auto-detected by type=morse / SPI)
#   - 5 GHz EUD AP on the onboard CYW43455  (mmc path)  -> operator phone/tablet
#   - 2.4 GHz AP on ONE USB dongle          (usb path)  -> other players' EUDs
#   - batman-adv bat0 bridged into br-ahwlan (L2 mesh)
# Roles: gateway  (gw_mode=server, DHCP server, NAT uplink on $WAN_IFACE)
#        meshpoint(gw_mode=client, no DHCP server — the gateway serves the L2)
#
# Radios are matched by type/bus PATH (not radioN names), so this works on a
# freshly flashed node regardless of USB enumeration order.
#
# Run ON the node (BusyBox ash / POSIX sh):
#   scp magk-provision-node.sh node.env root@<node>:/tmp/
#   ssh root@<node> 'sh /tmp/magk-provision-node.sh /tmp/node.env'
# Idempotent: safe to re-run. Backs up /etc/config/{wireless,network,dhcp,firewall}.
# =============================================================================
set -eu

ENV_FILE="${1:-/etc/magk-node.env}"
[ -f "$ENV_FILE" ] || { echo "ERROR: env file not found: $ENV_FILE" >&2; exit 1; }
# shellcheck disable=SC1090
. "$ENV_FILE"

# --- required / defaulted params --------------------------------------------
: "${NODE_NAME:?set NODE_NAME in env}"
: "${NODE_ROLE:?set NODE_ROLE=gateway|meshpoint}"
: "${MESH_KEY:?set MESH_KEY}"
NODE_MGMT_IP="${NODE_MGMT_IP:-}"   # gateway only; mesh-point IPs are owned by openmanetd
: "${EUD_5G_KEY:?set EUD_5G_KEY}"
: "${NET_24_KEY:?set NET_24_KEY}"
MGMT_NETMASK="${MGMT_NETMASK:-255.255.0.0}"
MESH_ID="${MESH_ID:-MAGK-NET}"
MESH_CHANNEL="${MESH_CHANNEL:-24}"
EUD_5G_SSID="${EUD_5G_SSID:-MAGK-EUD}"; EUD_5G_CHANNEL="${EUD_5G_CHANNEL:-36}"
NET_24_SSID="${NET_24_SSID:-MAGK-NET}"; NET_24_CHANNEL="${NET_24_CHANNEL:-6}"
WAN_IFACE="${WAN_IFACE:-eth0}"
FAST_ROAM="${FAST_ROAM:-1}"        # 1 = enable 802.11r/k/v fast roaming on the APs
COUNTRY="${COUNTRY:-US}"           # regulatory domain, applied to EVERY radio below
case "$NODE_ROLE" in gateway|meshpoint) ;; *) echo "ERROR: NODE_ROLE must be gateway|meshpoint" >&2; exit 1;; esac

echo "==> provisioning $NODE_NAME as $NODE_ROLE (mesh $MESH_ID ch$MESH_CHANNEL)"

# --- ensure radios are enumerated + a wireless config exists -----------------
# (At first boot the USB/SPI phys + /etc/config/wireless may not be ready yet.)
i=0; while [ "$i" -lt 25 ]; do [ -e /sys/class/ieee80211/phy0 ] && break; i=$((i+1)); sleep 1; done
[ -s /etc/config/wireless ] || wifi config 2>/dev/null || true

# --- backups ----------------------------------------------------------------
TS="$(date +%s)"
for f in wireless network dhcp firewall; do
  [ -f "/etc/config/$f" ] && cp "/etc/config/$f" "/etc/config/$f.bak.provision.$TS"
done

# --- classify radios by type / bus path -------------------------------------
MORSE=""; ONBOARD=""; DONGLE=""; EXTRAS=""
for dev in $(uci show wireless | sed -n 's/^wireless\.\([^.]*\)=wifi-device/\1/p'); do
  t="$(uci -q get wireless.$dev.type || true)"
  p="$(uci -q get wireless.$dev.path || true)"
  if [ "$t" = "morse" ]; then MORSE="$dev"
  elif echo "$p" | grep -q "mmc"; then ONBOARD="$dev"
  elif echo "$p" | grep -q "usb"; then
    if [ -z "$DONGLE" ]; then DONGLE="$dev"; else EXTRAS="$EXTRAS $dev"; fi
  else EXTRAS="$EXTRAS $dev"; fi
done
echo "    radios: morse=$MORSE onboard=$ONBOARD dongle=$DONGLE extras=[$EXTRAS]"

# --- regulatory domain (MUST be set on EVERY radio) -------------------------
# Previously COUNTRY was accepted in the env and then never applied, which left
# `iw reg get` at the world domain "00" and the 5 GHz radio with no country at
# all. Set it on every wifi-device we know about, including extras, so no radio
# can come up without a regdomain.
for dev in $MORSE $ONBOARD $DONGLE $EXTRAS; do
  [ -n "$dev" ] || continue
  uci set wireless.$dev.country="$COUNTRY"
done
echo "    regulatory domain: $COUNTRY (applied to all radios)"
[ -n "$MORSE" ] || { echo "ERROR: no morse (HaLow) radio found — wrong image/board?" >&2; exit 1; }

# --- band assignment by onboard 5GHz capability -----------------------------
# EUD AP = 5 GHz (operator's phone/tablet); NET AP = 2.4 GHz (other players).
# Which radio hosts which band depends on what the onboard Wi-Fi can do:
#   * Pi4 CYW43455 (dual-band): onboard -> 5GHz EUD, USB dongle -> 2.4GHz NET
#   * Pi Zero (2.4GHz-only onboard): onboard -> 2.4GHz NET, USB dongle -> 5GHz EUD
phy_supports_5g() {  # $1 = sysfs bus substring (e.g. mmc); echoes yes|no
  for phy in $(ls /sys/class/ieee80211 2>/dev/null); do
    rp="$(readlink -f "/sys/class/ieee80211/$phy/device" 2>/dev/null)"
    case "$rp" in *"$1"*)
      if iw phy "$phy" info 2>/dev/null | grep -qE '\* 5[0-9]{3}(\.[0-9]+)? MHz'; then echo yes; else echo no; fi
      return ;; esac
  done
  echo no
}
ONBOARD_5G=no
[ -n "$ONBOARD" ] && ONBOARD_5G="$(phy_supports_5g mmc)"
if [ "$ONBOARD_5G" = yes ]; then
  EUD5G_DEV="$ONBOARD"; NET24_DEV="$DONGLE"
else
  NET24_DEV="$ONBOARD"; EUD5G_DEV="$DONGLE"
fi
echo "    onboard 5GHz capable: $ONBOARD_5G  ->  EUD(5G)=${EUD5G_DEV:-none}  NET(2.4G)=${NET24_DEV:-none}"
[ -n "$EUD5G_DEV" ] || echo "WARN: no radio available for the 5GHz EUD AP — skipping it" >&2
[ -n "$NET24_DEV" ] || echo "WARN: no radio available for the 2.4GHz NET AP — skipping it" >&2

# --- hostname ---------------------------------------------------------------
uci set system.@system[0].hostname="$NODE_NAME"
[ -f /proc/sys/kernel/hostname ] && echo "$NODE_NAME" > /proc/sys/kernel/hostname || true

# Apply 802.11r/k/v fast roaming to an AP section so non-MANET clients hand off
# cleanly between nodes (same ESS bridged over the batman mesh).
#   $1 = wifi-iface section   $2 = mobility_domain (4 hex, stable per SSID)
set_roaming() {
  uci set wireless.$1.ieee80211r='1'            # 802.11r Fast BSS Transition
  uci set wireless.$1.mobility_domain="$2"
  uci set wireless.$1.ft_psk_generate_local='1' # derive FT keys locally from PSK (no r0kh/r1kh lists)
  uci set wireless.$1.ft_over_ds='0'            # over-the-air FT (most compatible)
  uci set wireless.$1.reassociation_deadline='1000'
  uci set wireless.$1.ieee80211k='1'            # 802.11k neighbor/beacon reports
  uci set wireless.$1.rrm_neighbor_report='1'
  uci set wireless.$1.rrm_beacon_report='1'
  uci set wireless.$1.bss_transition='1'        # 802.11v BSS Transition Management
  uci set wireless.$1.wnm_sleep_mode='1'
}

# =============================================================================
# WIRELESS — wipe wifi-iface sections, recreate deterministically
# =============================================================================
for s in $(uci show wireless | sed -n "s/^wireless\.\([^.]*\)=wifi-iface/\1/p"); do
  uci -q delete "wireless.$s" || true
done

# HaLow mesh on the morse radio
uci set wireless.$MORSE.disabled='0'
uci set wireless.$MORSE.channel="$MESH_CHANNEL"
[ -n "${MESH_HTMODE:-}" ] && uci set wireless.$MORSE.htmode="$MESH_HTMODE" || true
mesh="wifinet_mesh"
uci -q delete "wireless.$mesh" || true
uci set wireless.$mesh=wifi-iface
uci set wireless.$mesh.device="$MORSE"
uci set wireless.$mesh.mode='mesh'
uci set wireless.$mesh.mesh_id="$MESH_ID"
uci set wireless.$mesh.network='batmesh0'
uci set wireless.$mesh.encryption='sae'
uci set wireless.$mesh.key="$MESH_KEY"
uci set wireless.$mesh.mesh_fwding='0'   # states intent; NOT the effective source (see below)
uci set wireless.$mesh.beacon_int='1000'

# 802.11s mesh_fwding MUST also be disabled at its REAL source, /etc/config/mesh11sd.
# netifd-morse generates /var/run/wpa_supplicant-<meshif>.conf from
# mesh11sd.mesh_params.*, NOT from the wifi-iface options above -- and it does so
# even when the mesh11sd DAEMON is disabled (enabled='0'), because the file is used
# purely as a parameter source. The shipped default mesh_fwding='1' therefore wins,
# leaving BOTH 802.11s and batman-adv forwarding the same frames (duplicate paths,
# wasted airtime; bridge_loop_avoidance does not cover this).
# Verified on an RPi4/MM6108 gateway 2026-09-06: setting only
# wireless.$mesh.mesh_fwding='0' left mesh_fwding=1 in both the generated conf and
# the kernel (iw dev <meshif> get mesh_param mesh_fwding); setting it here flipped
# both to 0. The same applies to mesh_rssi_threshold / mesh_beaconless_mode /
# mesh_dynamic_peering, which also arrive from this file.
uci set mesh11sd.mesh_params.mesh_fwding='0'

# 5 GHz EUD AP (operator) — on whichever radio can do 5 GHz
if [ -n "$EUD5G_DEV" ]; then
  uci set wireless.$EUD5G_DEV.disabled='0'
  uci set wireless.$EUD5G_DEV.band='5g'
  uci set wireless.$EUD5G_DEV.channel="$EUD_5G_CHANNEL"
  uci -q delete "wireless.wifinet_eud5g" || true
  uci set wireless.wifinet_eud5g=wifi-iface
  uci set wireless.wifinet_eud5g.device="$EUD5G_DEV"
  uci set wireless.wifinet_eud5g.mode='ap'
  uci set wireless.wifinet_eud5g.ssid="$EUD_5G_SSID"
  uci set wireless.wifinet_eud5g.network='ahwlan'
  uci set wireless.wifinet_eud5g.encryption='psk2'
  uci set wireless.wifinet_eud5g.key="$EUD_5G_KEY"
  [ "$FAST_ROAM" = 1 ] && set_roaming wifinet_eud5g 'ed05'
fi

# 2.4 GHz NET AP (other players) — on the remaining radio
if [ -n "$NET24_DEV" ]; then
  uci set wireless.$NET24_DEV.disabled='0'
  uci set wireless.$NET24_DEV.band='2g'
  uci set wireless.$NET24_DEV.channel="$NET_24_CHANNEL"
  uci -q delete "wireless.wifinet_net24" || true
  uci set wireless.wifinet_net24=wifi-iface
  uci set wireless.wifinet_net24.device="$NET24_DEV"
  uci set wireless.wifinet_net24.mode='ap'
  uci set wireless.wifinet_net24.ssid="$NET_24_SSID"
  uci set wireless.wifinet_net24.network='ahwlan'
  uci set wireless.wifinet_net24.encryption='psk2'
  uci set wireless.wifinet_net24.key="$NET_24_KEY"
  [ "$FAST_ROAM" = 1 ] && set_roaming wifinet_net24 'be24'
fi

# disable any extra/unused radios (e.g. a second dongle, phantom mac80211-on-SPI)
for d in $EXTRAS; do uci set wireless.$d.disabled='1'; done

# =============================================================================
# NETWORK — batman-adv bat0 bridged into br-ahwlan
# =============================================================================
# bat0 batman device + role
uci set network.bat0=interface
uci set network.bat0.proto='batadv'
uci set network.bat0.routing_algo='BATMAN_V'
uci set network.bat0.bridge_loop_avoidance='1'
uci set network.bat0.distributed_arp_table='1'
uci set network.bat0.multicast_mode='0'
uci set network.bat0.orig_interval='1000'
if [ "$NODE_ROLE" = "gateway" ]; then
  uci set network.bat0.gw_mode='server'
else
  uci set network.bat0.gw_mode='client'
fi

# morse mesh hardif -> bat0
uci set network.batmesh0=interface
uci set network.batmesh0.proto='batadv_hardif'
uci set network.batmesh0.master='bat0'

# Remove the factory lan/br-lan FIRST -- before br-ahwlan is located/created below.
# NEITHER role wants it, and left in place it COMPETES for $WAN_IFACE: the stock
# config bridges eth0 into br-lan, so once eth0 is also claimed (network.wan on a
# gateway, or br-ahwlan's port list on a meshpoint) the same netdev has two owners.
# netifd's resolution is undefined -- typically the bridge captures the netdev and
# the gateway's WAN DHCP client never gets a lease -- and on a gateway it
# additionally leaves a second overlapping /16 (br-lan 10.41.254.1 vs br-ahwlan
# 10.41.0.1), making routing ambiguous. Deleting network.lan alone is NOT enough:
# the `config device` section named br-lan holds the port list and must go too.
# This is the long-standing "provisioned gateway has no uplink / is unreachable"
# failure; observed again on an RPi4/MM6108 gateway 2026-09-06.
#
# ORDER MATTERS: UCI anonymous section indices are positional, so deleting a
# @device[N] RENUMBERS every later one. Doing this before the br-ahwlan
# find-or-create below means $brsec is resolved against the final numbering; the
# reverse order can leave $brsec pointing at a shifted (wrong) section.
uci -q delete network.lan || true
uci -q delete dhcp.lan || true
lansec=""
for s in $(uci show network | sed -n "s/^network\.\(@device\[[0-9]*\]\)\.name='br-lan'/\1/p"); do lansec="$s"; done
[ -n "$lansec" ] && uci -q delete "network.$lansec" || true

# br-ahwlan bridge (the EUD/mesh L2; APs bridge in via network='ahwlan').
# Find-or-create the bridge device section.
brsec=""
for s in $(uci show network | sed -n "s/^network\.\(@device\[[0-9]*\]\)\.name='br-ahwlan'/\1/p"); do brsec="$s"; done
if [ -z "$brsec" ]; then
  brsec="$(uci add network device)"
  uci set network.$brsec.name='br-ahwlan'
fi
uci set network.$brsec.type='bridge'

if [ "$NODE_ROLE" = "gateway" ]; then
  # Gateway: fixed static mgmt IP (DHCP server + NAT need a stable subnet anchor).
  uci set network.ahwlan=interface
  uci set network.ahwlan.proto='static'
  uci set network.ahwlan.device='br-ahwlan'
  uci set network.ahwlan.ipaddr="${NODE_MGMT_IP:-10.41.0.1}"
  uci set network.ahwlan.netmask="$MGMT_NETMASK"
  uci set network.$brsec.ports='bat0'
  # uplink: WAN_IFACE as DHCP client to upstream
  uci set network.wan=interface
  uci set network.wan.device="$WAN_IFACE"
  uci set network.wan.proto='dhcp'
else
  # Mesh point: openmanetd OWNS the mgmt IP (a unique MAC-derived 10.41.x.x) and
  # rewrites it on every boot, so we DO NOT set network.ahwlan.ipaddr here —
  # forcing one is futile. WAN_IFACE becomes a wired LAN port bridged into the
  # mesh L2 (a wired EUD/laptop on it joins the mesh + gets DHCP from the gateway).
  uci -q delete network.wan || true
  uci set network.$brsec.ports="bat0 $WAN_IFACE"
fi

# =============================================================================
# DHCP — gateway serves the shared L2; meshpoint must NOT run a DHCP server
# =============================================================================
if [ "$NODE_ROLE" = "gateway" ]; then
  uci set dhcp.ahwlan=dhcp
  uci set dhcp.ahwlan.interface='ahwlan'
  uci set dhcp.ahwlan.start='100'
  uci set dhcp.ahwlan.limit='150'
  uci set dhcp.ahwlan.leasetime='12h'
  uci set dhcp.ahwlan.force='1'
  uci -q delete dhcp.ahwlan.ignore || true
else
  uci set dhcp.ahwlan=dhcp
  uci set dhcp.ahwlan.interface='ahwlan'
  uci set dhcp.ahwlan.ignore='1'
fi

# =============================================================================
# FIREWALL — gateway NATs ahwlan->WAN; meshpoint just accepts the ahwlan zone
# =============================================================================
# ahwlan zone (find-or-create by name)
ahz=""
for z in $(uci show firewall | sed -n "s/^firewall\.\([^.]*\)\.name='ahwlan'/\1/p"); do ahz="$z"; done
[ -n "$ahz" ] || { ahz="$(uci add firewall zone)"; uci set firewall.$ahz.name='ahwlan'; }
uci set firewall.$ahz.network='ahwlan'
uci set firewall.$ahz.input='ACCEPT'
uci set firewall.$ahz.output='ACCEPT'
uci set firewall.$ahz.forward='ACCEPT'

if [ "$NODE_ROLE" = "gateway" ]; then
  wz=""
  for z in $(uci show firewall | sed -n "s/^firewall\.\([^.]*\)\.name='wan'/\1/p"); do wz="$z"; done
  [ -n "$wz" ] || { wz="$(uci add firewall zone)"; uci set firewall.$wz.name='wan'; }
  uci set firewall.$wz.network='wan'
  uci set firewall.$wz.input='REJECT'
  uci set firewall.$wz.output='ACCEPT'
  uci set firewall.$wz.forward='REJECT'
  uci set firewall.$wz.masq='1'
  # allow ahwlan -> wan forwarding
  fwd=""
  for f in $(uci show firewall | sed -n "s/^firewall\.\([^.]*\)\.name='ahwlan-wan'/\1/p"); do fwd="$f"; done
  [ -n "$fwd" ] || { fwd="$(uci add firewall forwarding)"; uci set firewall.$fwd.name='ahwlan-wan'; }
  uci set firewall.$fwd.src='ahwlan'
  uci set firewall.$fwd.dest='wan'
fi

# =============================================================================
# COMMIT + APPLY
# =============================================================================
uci commit
if [ "${MAGK_NO_RELOAD:-0}" = "1" ]; then
  echo "==> committed (MAGK_NO_RELOAD=1: skipping reload; config applies on next boot/service start)"
else
  echo "==> committed; reloading network + wifi"
  /etc/init.d/network reload 2>/dev/null || /etc/init.d/network restart
  /etc/init.d/dnsmasq reload 2>/dev/null || true
  /etc/init.d/firewall reload 2>/dev/null || true
  wifi reload 2>/dev/null || wifi
  sleep 8
fi

echo "==> done. summary:"
echo "  hostname : $(uci -q get system.@system[0].hostname)"
if [ "$NODE_ROLE" = "gateway" ]; then
  echo "  role     : gateway (bat0.gw_mode=$(uci -q get network.bat0.gw_mode)), mgmt ip $(uci -q get network.ahwlan.ipaddr)"
else
  echo "  role     : meshpoint (bat0.gw_mode=$(uci -q get network.bat0.gw_mode)); mgmt IP assigned by openmanetd (find via 'batctl meshif bat0 dat_cache' on the gateway, or hostname $NODE_NAME)"
fi
echo "  mesh     : id=$MESH_ID ch$MESH_CHANNEL  | morse=$MORSE"
echo "  5G EUD   : ${EUD_5G_SSID:-skip} on ${ONBOARD:-none}"
echo "  2.4G NET : ${NET_24_SSID:-skip} on ${DONGLE:-none}"
command -v morse_cli >/dev/null && { printf "  halow    : "; morse_cli -i wlan0 channel 2>/dev/null | tr '\n' ' '; echo; }
echo "  live APs : $(iw dev 2>/dev/null | grep -c 'type AP')"
echo "Run validate-gw1.sh / batctl meshif bat0 n to confirm mesh peering."
